<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.antonio.Mithrandir</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Mithrandir</name>
  <summary>Linux system maintenance suite, cleaner, optimizer, and AI diagnostic assistant</summary>
  <description>
    <p>
      Mithrandir is a modern Linux cleaner and system management companion built with Python, GTK4, and Libadwaita. Inspired by classic utilities like BleachBit and Stacer, Mithrandir combines deep cleaning with modern GNOME design patterns and intelligent system diagnostics.
    </p>
    <p>
      Whether decluttering application caches, monitoring resource consumption across CPU cores, or getting AI advice on system anomalies, Mithrandir keeps your desktop running smoothly.
    </p>
    <ul>
      <li>System Cleaning: Safe cleaning of package manager residues, cache files, old crash logs, and browser caches</li>
      <li>Hardware Monitoring: Live visualization of processor cores, RAM usage, swap space, and disk partitions</li>
      <li>Systemd &amp; Startup Manager: Inspect, enable, or mask system services and desktop autostart applications</li>
      <li>Interactive Process Manager: Real-time process listing with priority adjustment and search filtering</li>
      <li>AI System Assistant: Automated troubleshooting suggestions and command generation for system errors</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/Antux912012/mithrandir</url>
  <url type="bugtracker">https://github.com/Antux912012/mithrandir/issues</url>
  <developer id="io.github.antonio">
    <name>Antonio</name>
  </developer>
  <launchable type="desktop-id">io.github.antonio.Mithrandir.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.4.1" date="2026-10-18">
      <description>
        <p>Release v0.4.1 with native Google Gemini AI Studio and Anthropic Claude support:</p>
        <ul>
          <li>Added native Google Gemini AI API support distributed via Google AI Studio (v1beta generateContent and model discovery)</li>
          <li>Added Anthropic Claude API support alongside OpenAI, NVIDIA NIM, Ollama, LM Studio, and llama.cpp</li>
          <li>Updated AI Diagnostics and Preferences UI with Gemini and Claude provider presets and model selectors</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-16">
      <description>
        <p>Major feature release v0.4.0 with expanded AI integration, offline Mini-LLMs, and performance hardening:</p>
        <ul>
          <li>OpenAI-compatible model selection and API key management for NVIDIA NIM, OpenAI, and OpenRouter</li>
          <li>Built-in zero-dependency Offline Linux Mini-Assistant for instant offline diagnostics and generic Linux tasks</li>
          <li>Local Offline Mini-LLM Manager supporting Ollama, LM Studio, and llama.cpp with one-click installation and model downloading</li>
          <li>Interactive Generic Linux Task Assistant with prompt bar and quick task chips</li>
          <li>Optimized system telemetry collection off the main UI thread to eliminate interface freezing</li>
          <li>Process manager fixes for CPU percentage accuracy and robust /proc inspection fallback</li>
          <li>Smart Boost clutter scanning optimizations and Pango markup escaping fixes across all pages</li>
        </ul>
      </description>
    </release>
    <release version="0.3.5" date="2026-10-13">
      <description>
        <p>Production release v0.3.5 with new official application icon and full asset set:</p>
        <ul>
          <li>Introduced new custom wizard iconography in scalable SVG and all standard hicolor dimensions (16x16 through 512x512)</li>
          <li>Refactored and hardened Flatpak sandbox boundary and D-Bus host communication</li>
          <li>Real-time telemetry performance optimizations with zero D-Bus overhead</li>
          <li>Enhanced ClamAV malware protection, FreshClam synchronization, and quarantine manager</li>
          <li>Updated documentation and packaging metadata</li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-10-13">
      <description>
        <p>Flatpak sandboxing overhaul and performance improvements:</p>
        <ul>
          <li>Fixed host process visibility and process termination in Flatpak environments</li>
          <li>Optimized hardware and sensor polling with zero D-Bus overhead for fluid GUI performance</li>
          <li>Added support for Flatpak cache directory inspection and cleaning</li>
          <li>Fixed ClamAV CVD database validation and host quarantine restoration in Flatpak</li>
          <li>Fixed GRUB configuration manager and update detection in Flatpak</li>
          <li>Fixed autostart command generation for Flatpak installs</li>
          <li>Fixed Pango markup escaping in process manager and uninstaller views</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-12">
      <description>
        <p>ClamAV antivirus integration, quarantine vault, Python package management, and system optimizer suite.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-11">
      <description>
        <p>Btrfs/Snapper snapshot management, GRUB bootloader editor, and Smart Boost background optimization.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-11">
      <description>
        <p>Initial release of Mithrandir with cleaner, monitoring, and AI diagnostic capabilities.</p>
      </description>
    </release>
  </releases>
</component>
