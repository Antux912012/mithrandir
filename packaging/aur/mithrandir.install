post_install() {
    echo "================================================================================"
    echo "  :: Mithrandir v1.0.0 installed successfully! 🦀"
    echo "  :: Native GTK4/Libadwaita System Optimizer, CachyOS Scheduler & Power Manager"
    echo "================================================================================"
    echo "  * Launch the application:          mithrandir"
    echo "  * Start in system tray icon:       mithrandir --background"
    echo "  * Polkit Policy:                   /usr/share/polkit-1/actions/io.github.antonio.Mithrandir.policy"
    echo "  * Hardware Power Saver udev rules: /usr/lib/udev/rules.d/99-mithrandir-power.rules"
    echo "================================================================================"
}

post_upgrade() {
    post_install
}
