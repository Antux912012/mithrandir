[Desktop Entry]
Name=Mithrandir
GenericName=System Cleaner, Optimizer and Hardware Power Saver
Comment=Modern GNU/Linux Cleaner, Optimizer, Hardware Power Saver, Telemetry & Diagnostics in Rust
Exec=mithrandir %U
Icon=io.github.antonio.Mithrandir
Terminal=false
Type=Application
Categories=Utility;System;
StartupNotify=true
Actions=smart-boost;monitor;background;

[Desktop Action smart-boost]
Name=⚡ Smart Boost
Exec=mithrandir --smart-boost

[Desktop Action monitor]
Name=📊 System Monitor
Exec=mithrandir --monitor

[Desktop Action background]
Name=🛡️ Start in System Tray
Exec=mithrandir --background
